
<view class="out">
<!-- 博客内容区 -->
<view class="blogRow">

<!-- 博客上方的标题,描述信息,状态,和内容 -->
    <van-panel title="标题" desc="描述信息" status="状态">
        <view class="blogContent">内容</view>

        <!-- 这个是底部的点赞,评论,和时间 -->
        <view slot="footer" class="blogFoot">
        <!-- 时间 -->
            <view class="time">time</view>
            <!-- 点赞和评论 -->
            <view>
                <van-button size="small" type="danger" icon="good-job-o" plain>点赞</van-button>
                <van-button size="small" type="primary" icon="chat-o" plain >评论</van-button>
            </view>

        </view>
    </van-panel>
</view>
</view>
