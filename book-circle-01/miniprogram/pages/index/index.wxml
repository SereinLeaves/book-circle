<view class="out">
  <!-- AddBlog:点击授权,并且跳转到添加博客页面,固定在页面上 -->
  <view class="addBlog" bindtap="addBlog">
    <van-button icon="plus" type="primary" size="normal" round/>
  </view>

<!-- 内容面板 -->
  <van-panel wx:for="{{blogList}}" wx:key="item._id">

    <!-- 博客顶部:用户头像,昵称,地址,手机型号 -->
    <view class="blogTop">
        <van-cell icon="{{userInfo.avatarUrl}}" title="{{userInfo.nickName}}" value="时间" class="van_cell" border="{{ false }}" center />



    </view>

    <!-- 博客内容:文字和图片 -->
    <view class="blogContent">
      <view class="text">{{item.content}}</view>
      <view class="picture">
        <van-grid column-num="3" border="{{ false }}">
          <van-grid-item use-slot wx:for="{{item.picarr}}" wx:for-item="picitem" wx:for-index="picindex">
            <image style="width: 100%; height: 90px;" src="{{picitem}}" />
          </van-grid-item>
        </van-grid>
      </view>
    </view>

    <!-- 博客底部:发布时间,点赞,评论 -->
    <view class="blogBottom" slot="footer">
      <!-- 时间 -->
      <!-- <view class="time" left>原来是昨天</view> -->
      <!-- 点赞和评论 -->
      <van-button size="small" type="danger" icon="good-job-o" plain>点赞</van-button>
        <van-button size="small" type="primary" icon="chat-o" plain>评论</van-button>
        <van-button size="small" type="info" icon="share-o" plain>分享</van-button>

    </view>

  </van-panel>

</view>