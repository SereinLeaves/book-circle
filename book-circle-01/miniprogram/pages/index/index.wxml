<wxs module="time" src="../time.wxs"></wxs>

<view class="out">
  <!-- AddBlog:点击授权,并且跳转到添加博客页面,固定在页面上 -->
  <view class="addBlog" bindtap="addBlog">
    <van-button icon="plus" type="primary" size="normal" round/>
  </view>

<!-- 内容面板 -->
  <van-panel wx:for="{{blogList}}" bindtap="jumpContentPage">

    <!-- 博客顶部:用户头像,昵称,地址,手机型号 -->
    <view class="blogTop">
        <van-cell class="van_cell" icon="{{item.userInfo?item.userInfo.avatarUrl:'../../images/icon_girl.png'}}" title="{{item.userInfo?item.userInfo.nickName:'匿名'}}" value="《书名》"  border="{{ false }}" center />
    </view>

    <!-- 博客内容:文字和图片 -->
    <view class="blogContent" bindlongpress="bindlongpress">
      <view class="text">
      <text	user-select="true">
        {{item.content}}
      </text>
      </view>
      <view class="picture">
        <van-grid column-num="3" border="{{false}}">
          <van-grid-item 
          use-slot
          wx:key="*this"
          wx:for="{{item.picarr}}" 
          wx:for-item="picitem" 
          wx:for-index="picindex"
          data-picarr="{{item.picarr}}"
          data-picindex="{{picindex}}"
          bindtap="clickImg"
          >
            <van-image src="{{picitem}}" fit="cover" />
          </van-grid-item>
        </van-grid>
      </view>
    </view>

    <!-- 博客底部:发布时间,点赞,评论 -->
    <view class="blogBottom" slot="footer">
      <!-- 时间 -->
      <view class="time" left>{{time.timesFun(item.posttime)}}</view>
      <!-- 点赞和评论 -->
      <view>
        <van-button size="small" type="danger" icon="good-job-o" plain class="clickLike" bindtap="clickLike">点赞</van-button>
        <van-button size="small" type="primary" icon="chat-o" plain class="clickComment" bindtap="clickComment">评论</van-button>
      </view>
    </view>

  </van-panel>

</view>