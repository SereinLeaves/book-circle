<view class="out" style="color: #ffffff;">
    <view class="userOut" wx:if="{{userInfo.nickName}}">
    <van-cell icon="{{userInfo.avatarUrl}}" title="{{userInfo.nickName}}" center/>
</view>

<view class="userOut" wx:else>
    <van-cell icon="friends" title="点击登录" center bindtap="goLogin" />
</view>

<van-divider />

<van-cell-group>
  <van-cell title="我的帖子" icon="column"/>
  <van-cell title="我的收藏" icon="bookmark"/>
  <van-cell title="我的通知" icon="bell"/>
</van-cell-group>


</view>


